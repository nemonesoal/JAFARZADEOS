#!/bin/sh
set -e
printf '%s\n' 'JAFARZADEOS' > /etc/hostname
cat > /etc/os-release <<'OSREL'
PRETTY_NAME="JAFARZADEOS 1.1"
NAME="JAFARZADEOS"
ID=jafarzadeos
ID_LIKE=debian
VERSION="1.1"
VERSION_ID="1.1"
OSREL
for loc in fa_IR.UTF-8 en_US.UTF-8; do
  grep -q "^${loc} UTF-8" /etc/locale.gen || echo "${loc} UTF-8" >> /etc/locale.gen
done
locale-gen || true
mkdir -p /etc/NetworkManager/conf.d
cat > /etc/NetworkManager/conf.d/10-jafarzadeos.conf <<'NM'
[main]
plugins=keyfile
NM
chmod +x /etc/skel/Desktop/*.desktop 2>/dev/null || true
chmod +x /usr/local/bin/jafarzadeos-control 2>/dev/null || true
